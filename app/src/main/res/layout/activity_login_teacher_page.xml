<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LoginTeacherPage"
    android:background="@drawable/mainbackground"
    >

    <EditText
        android:id="@+id/LoginTeacherNameText"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginTop="230dp"
        android:backgroundTint="@color/mainTextBlue"
        android:ems="10"
        android:hint="Name"
        android:inputType="text"
        android:textColorHint="@color/mainTextBlue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/LoginTeacherIDText"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginTop="300dp"
        android:backgroundTint="@color/mainTextBlue"
        android:ems="10"
        android:hint="ID"
        android:inputType="text"
        android:textColorHint="@color/mainTextBlue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/LoginTeacherLoginSubmitButton"
        android:layout_width="144dp"
        android:layout_height="49dp"
        android:layout_marginTop="400dp"
        android:background="@drawable/mainbuttonborder"
        android:text="Login"
        android:textColor="@color/mainTextBlue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>