<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fillViewport="true">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TableLayout
            android:id="@+id/TeacherTimetable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:stretchColumns="*"
            android:padding="8dp"
            android:layout_margin="8dp">

            <!-- Table Header Row (Time Slots) -->
            <TableRow android:background="@color/mainBlueColor">
                <TextView
                    android:text="Day/Time"
                    android:padding="12dp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@android:color/white" />

                <TextView
                    android:text="8:45 - 9:45"
                    android:padding="12dp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@android:color/white" />

                <TextView
                    android:text="9:45 - 10:45"
                    android:padding="12dp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@android:color/white" />

                <TextView
                    android:text="Break"
                    android:padding="12dp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@android:color/holo_red_light" />

                <TextView
                    android:text="11:15 - 12:15"
                    android:padding="12dp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@android:color/white" />

                <TextView
                    android:text="12:15 - 1:15"
                    android:padding="12dp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@android:color/white" />
            </TableRow>

            <!-- Static Rows for Days -->
            <TableRow>
                <TextView android:text="Monday"
                    android:padding="12dp"
                    android:gravity="center"
                    android:textSize="18sp"
                    android:textColor="@android:color/black"/>
            </TableRow>

            <TableRow>
                <TextView android:text="Tuesday"
                    android:padding="12dp"
                    android:gravity="center"
                    android:textSize="18sp"
                    android:textColor="@android:color/black"/>
            </TableRow>

            <TableRow>
                <TextView android:text="Wednesday"
                    android:padding="12dp"
                    android:gravity="center"
                    android:textSize="18sp"
                    android:textColor="@android:color/black"/>
            </TableRow>

            <TableRow>
                <TextView android:text="Thursday"
                    android:padding="12dp"
                    android:gravity="center"
                    android:textSize="18sp"
                    android:textColor="@android:color/black"/>
            </TableRow>

            <TableRow>
                <TextView android:text="Friday"
                    android:padding="12dp"
                    android:gravity="center"
                    android:textSize="18sp"
                    android:textColor="@android:color/black"/>
            </TableRow>

            <TableRow>
                <TextView android:text="Saturday"
                    android:padding="12dp"
                    android:gravity="center"
                    android:textSize="18sp"
                    android:textColor="@android:color/black"/>
            </TableRow>

        </TableLayout>
    </HorizontalScrollView>
</ScrollView>
